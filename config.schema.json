{
  "pluginAlias": "LutronRadioRA3",
  "pluginType": "platform",
  "customUi": true,
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "default": "Lutron RadioRA 3",
        "required": true
      },
      "options": {
        "type": "object",
        "properties": {
          "filterPico": {
            "type": "boolean",
            "title": "Exclude Pico remotes that are associated with devices directly or in the Lutron app"
          },
          "clickSpeed": {
            "type": "string",
            "title": "Double- and long-press speed",
            "oneOf": [
              { "title": "Fast", "enum": ["fast"] },
              { "title": "Medium (default)", "enum": ["medium"] },
              { "title": "Slow", "enum": ["slow"] }
            ]
          },
          "virtualButtons": {
            "type": "array",
            "title": "Virtual Buttons (scenes) to expose to HomeKit as switches",
            "items": {
              "type": "string",
              "title": "Virtual Button name (must match the name in the Lutron app exactly)"
            }
          },
          "zones": {
            "type": "array",
            "title": "Zones (switches/dimmers) to control directly, bypassing RA3's native HomeKit bridge",
            "items": {
              "type": "string",
              "title": "Zone name (must match the name in the Lutron app exactly)"
            }
          }

        }
      },
      "secrets": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "processorID": { "type": "string" },
            "ca": { "type": "string" },
            "key": { "type": "string" },
            "cert": { "type": "string" }
          },
          "required": ["ca", "key", "cert"]
        }
      }
    }
  },
  "layout": [
    {"key": "options",
      "type": "div",
      "displayFlex": true,
      "items": [
        {
          "key": "options.filterPico",
          "notitle": false,
          "type": "boolean",
          "flex": "1 1 150px"
        },
        {
          "key": "options.clickSpeed",
          "notitle": false,
          "type": "string",
          "flex": "1 1 150px"
        },
        {
          "key": "options.virtualButtons",
          "notitle": false,
          "title": "Virtual Buttons (scenes) to expose",
          "type": "array",
          "flex": "1 1 300px"
        },
        {
          "key": "options.zones",
          "notitle": false,
          "title": "Zones to control directly (disable RA3's native HomeKit export for these first)",
          "type": "array",
          "flex": "1 1 300px"
        }
      ]
    },
    {"key": "secrets",
      "type": "array",
      "listItems": 1,
      "items": [ {
        "type": "div",
        "displayFlex": true,
        "items": [
          {
            "key": "secrets[].processorID",
            "flex": "1 1 50px",
            "notitle": false,
            "title": "Processor ID Number (hex of serial number)",
            "placeholder": "Processor ID",
            "type": "string"
          },
          {
            "key": "secrets[].ca",
            "flex": "200px",
            "title": "CA certificate (caseta-bridge.crt)",
            "placeholder": "-----BEGIN CERTIFICATE-----...",
            "type": "textarea"
          },
          {
            "key": "secrets[].key",
            "flex": "200px",
            "title": "Private key (caseta.key)",
            "placeholder": "-----BEGIN PRIVATE KEY-----...",
            "type": "textarea"
          },
          {
            "key": "secrets[].cert",
            "flex": "200px",
            "title": "Signed certificate (caseta.crt)",
            "placeholder": "-----BEGIN CERTIFICATE-----...",
            "type": "textarea"
          }
        ]
      }
      ]
    }
  ]

}
